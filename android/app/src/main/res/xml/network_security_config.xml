<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permits local loopback (127.0.0.1 Termux) and LAN/Tailscale IP connections;
         use wss:// / TLS toggle in Connection Profiles when connecting over untrusted networks. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
